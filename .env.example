# Copy to .env (production) or .env.local (development) and fill in the values.

# SQLite database path (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Session encryption key — REQUIRED, at least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_PASSWORD=""

# Admin account created/updated by `npm run db:seed` (password: 12+ characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Formspree form ID for the contact form
NEXT_PUBLIC_FORMSPREE_ID=""
